// @see - https://www.electron.build/configuration/configuration
{
  "$schema": "https://raw.githubusercontent.com/electron-userland/electron-builder/master/packages/app-builder-lib/scheme.json",
  "appId": "ar.radarlaboral.desktop",
  "asar": true,
  "productName": "Radar Laboral",
  "directories": {
    "output": "release/${version}"
  },
  // Actualizaciones automaticas: el owner/repo se resuelve en build
  // desde RADAR_UPDATE_GITHUB_OWNER/RADAR_UPDATE_GITHUB_REPO (ver docs/instalacion.md).
  // Sin esas variables, electron-builder usa el placeholder y el build NO publica.
  "publish": {
    "provider": "github",
    "owner": "getodevel-source",
    "repo": "radarlaboral",
    "private": false,
    "releaseType": "release"
  },
  "files": [
    "dist/**",
    "dist-electron/**",
    "resources/tray.png",
    "resources/georef/localities.json",
    "!node_modules/better-sqlite3/prebuilds/darwin-*.node",
    "!node_modules/better-sqlite3/prebuilds/linux-*.node",
    "!node_modules/better-sqlite3/prebuilds/linuxmusl-*.node",
    "!node_modules/better-sqlite3/prebuilds/win32-arm64.node",
    "!node_modules/better-sqlite3/build/Release/obj/**",
    "!node_modules/better-sqlite3/build/Release/obj",
    "!node_modules/better-sqlite3/build/*.vcxproj*",
    "!node_modules/tesseract.js/docs/**",
    "!node_modules/tesseract.js/docs"
  ],
  "extraResources": [
    {
      "from": "resources/ocr",
      "to": "ocr"
    }
  ],
  "extraFiles": [
    {
      "from": "README.md",
      "to": "README.md"
    },
    {
      "from": "LICENSE",
      "to": "LICENSE"
    },
    {
      "from": "docs",
      "to": "docs",
      "filter": [
        "**/*.md",
        "**/*.txt",
        "images/**/*.png"
      ]
    },
    // El guard de evidencias vive en scripts/stage-package-evidence.mjs y scripts/smoke-package.mjs: el filter "**/*" es intencional.
    {
      "from": "package-evidence",
      "to": "package-evidence",
      "filter": ["**/*"]
    }
  ],
  "win": {
    "target": [
      {
        "target": "nsis",
        "arch": [
          "x64"
        ]
      }
    ],
    // Sin espacios: GitHubProvider resuelve descargas con espacios->guiones
    // (p.replace(/ /g, "-")) y un asset con espacios daria 404 al actualizar.
    "artifactName": "${name}-Windows-${version}-Setup.${ext}",
    "icon": "resources/icon.ico"
  },
  "nsis": {
    "include": "build/installer.nsh",
    "oneClick": false,
    "allowElevation": true,
    "perMachine": false,
    "deleteAppDataOnUninstall": false
  }
}
